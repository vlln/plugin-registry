{
  "name": "@dsh-external/plugin-console",
  "description": "薄控制台：浏览器 UI 管理官方 repository-plugins（读/写 $DSH_HOME/cordis.patch.yml），0 patch",
  "version": "0.1.0",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "lib/index.mjs",
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "test": "TSX_TSCONFIG_PATH=tests/tsconfig.json node --import tsx --test tests/discovery/*.spec.ts"
  },
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-tools": "^0.0.1"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "yaml": "^2.4.0",
    "tsx": "^4.19.0"
  },
  "dependencies": {
    "yaml": "^2.4.0"
  }
}
