+/**
+ * plugins domain zod schemas (names derived from map keys: pluginListRequestSchema /
+ * pluginListValueSchema / pluginInstall* / pluginEnable* / pluginDisable* / pluginUninstall*).
+ */
+
+import { z } from 'zod'
+import type { RequestPayload, ResponseValue } from './rpc-map.ts'
+import type { Wire } from './rpc.schema.ts'
+import type { PluginEntryView } from './plugins.ts'
+
+/** One plugin browse row. */
+export const pluginEntryViewSchema = z.object({
+  id: z.string().min(1),
+  version: z.string().min(1),
+  description: z.string(),
+  installed: z.boolean(),
+  enabled: z.boolean(),
+}) satisfies z.ZodType<Wire<PluginEntryView>>
+
+/** plugin.list request payload. */
+export const pluginListRequestSchema = z.object({}) satisfies z.ZodType<Wire<RequestPayload<'plugin.list'>>>
+
+/** plugin.list response value. */
+export const pluginListValueSchema = z.object({
+  plugins: z.array(pluginEntryViewSchema),
+}) satisfies z.ZodType<Wire<ResponseValue<'plugin.list'>>>
+
+/** The id-addressed request payload shared by install/enable/disable/uninstall. */
+export const pluginIdRequestSchema = z.object({
+  id: z.string().min(1),
+}) satisfies z.ZodType<Wire<RequestPayload<'plugin.install'>>>
+
+/** The id echo shared by install/enable/disable/uninstall response values. */
+export const pluginIdValueSchema = z.object({
+  id: z.string().min(1),
+}) satisfies z.ZodType<Wire<ResponseValue<'plugin.install'>>>
