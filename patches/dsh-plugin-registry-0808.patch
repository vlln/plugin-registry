+    const { bash } = await setup()
+    const proc = bash.start(bash.resolve({ command: 'echo first; sleep 1; echo second' }))
+    await readUntil(proc, 'first\n')
+
+    // A peek shows the retained stream since the cursor without advancing it.
+    const peeked = proc.peekOutput()
+    expect(peeked.delta).toContain('first\n')
+    expect(proc.peekOutput().delta).toBe(peeked.delta)
+
+    await proc.done
+    // The same retained tail stays visible to peeks after exit…
+    const tail = proc.peekOutput()
+    expect(tail.delta).toContain('second\n')
+    expect(proc.peekOutput().delta).toBe(tail.delta)
+    // …while a consuming read still delivers the full remaining delta once.
+    expect(proc.readOutput().delta).toBe('second\n')
+  })
