+import { describe, expect, it } from 'vitest'
+import { applyClientGraph } from '../src/client/index.ts'
+import type { ClientGraphEntryView } from '@deepseek-ai/dsh-client-connection/client'
+
+interface FakeEntry {
+  options: { name: string }
+  disabled: boolean
+  update: (o: { disabled: boolean }) => Promise<void>
+  updated: Array<{ disabled: boolean }>
+}
+
+function fakeLoader(initial: string[], disabled: string[] = []) {
+  const entries = new Map<string, FakeEntry>()
+  for (const name of initial) {
+    entries.set(name, { options: { name }, disabled: disabled.includes(name), updated: [], update: async (o) => { entries.get(name)!.disabled = o.disabled; entries.get(name)!.updated.push(o) } })
+  }
+  const created: string[] = []
+  return {
+    face: {
+      entries: () => entries.values(),
+      create: async (o: { name: string }) => { created.push(o.name); entries.set(o.name, { options: o, disabled: false, updated: [], update: async (x) => { entries.get(o.name)!.disabled = x.disabled } }) },
+    },
+    entries, created,
+  }
+}
+
+const entry = (id: string, rev = 'r1'): ClientGraphEntryView => ({ id, url: `/plugins/${id}/client.js?rev=${rev}`, rev })
+
+describe('applyClientGraph diff applier', () => {
+  it('creates added entries and registers their module rows', async () => {
+    const loader = fakeLoader(['a'])
+    const added: Array<{ id: string }> = []
+    const ctx = {
+      get: (name: string) => name === 'loader' ? loader.face
+        : name === 'modules' ? { addRow: (row: { id: string }) => { added.push(row) }, removeStyles: () => {} } : undefined,
+    } as never
+    await applyClientGraph(ctx as never, [entry('a'), entry('b')])
+    expect(loader.created).toEqual(['b'])
+    expect(added.map(r => r.id)).toEqual(['a', 'b'])
+  })
+
+  it('re-activates a disabled entry instead of creating', async () => {
+    const loader = fakeLoader(['a'], ['a'])
+    const ctx = {
+      get: (name: string) => name === 'loader' ? loader.face : { addRow: () => {}, removeStyles: () => {} },
+    } as never
+    await applyClientGraph(ctx as never, [entry('a')])
+    expect(loader.created).toEqual([])
+    expect(loader.entries.get('a')!.disabled).toBe(false)
+  })
+
+  it('disables removed entries in place and clears their styles', async () => {
+    const loader = fakeLoader(['a', 'b'])
+    const removed: string[] = []
+    const ctx = {
+      get: (name: string) => name === 'loader' ? loader.face : { addRow: () => {}, removeStyles: (id: string) => { removed.push(id) } },
+    } as never
+    await applyClientGraph(ctx as never, [entry('a')])
+    expect(loader.entries.get('b')!.disabled).toBe(true)
+    expect(loader.entries.get('a')!.disabled).toBe(false)
+    expect(removed).toEqual(['b'])
+  })
+})
