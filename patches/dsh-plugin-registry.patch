@@ -0,0 +1,164 @@
+/**
+ * The generic render-container service (`ctx.ui`): body-level official
+ * containers (fixed set, lazily created) into which plugins render their own
+ * React UI through an independent per-mount root. This is the "attach" axis
+ * of the client extension model — the slot system embeds into the official
+ * tree, mounts attach to floating regions with zero official component
+ * changes. React identity is shared (react/react-dom are platform seeds);
+ * isolation comes from the separate root, so official components (modals,
+ * primitives) render safely under a plugin mount.
+ */
+import { Component, createElement, type ErrorInfo, type ReactNode } from 'react'
+import { createRoot } from 'react-dom/client'
+import type { Context } from 'cordis'
+import { Service } from 'cordis'
+
+/** Official body-level container families (fixed set; MVP: floating kinds only). */
+export type UiContainerName = 'overlay' | 'floating'
+
+/** One plugin mount: an independent React root over a per-mount child node. */
+export interface UiMount {
+  /**
+   * Render into this mount's own root; repeat calls replace the content.
+   * @param node - the React tree to render (official components safe here).
+   */
+  render(node: ReactNode): void
+  /**
+   * Unmount the root and remove this mount's child node. The shared container
+   * node is owned by the service and stays for other mounts.
+   */
+  dispose(): void
+}
+
+/** Mount options: container family plus intra-container ordering. */
+export interface UiMountOptions {
+  /** Which official container family this mount renders into. */
+  container: UiContainerName
+  /** Child ordering inside the container (ascending; ties by mount order). */
+  priority?: number
+}
+
+/** Container styling: fixed overlay stack under the official modal stairs. */
+const CONTAINER_STYLE: Record<UiContainerName, string> = {
+  // 900-999 band: above page content, below official Modal (1000) / Menu (1100).
+  overlay: 'position:fixed;inset:0;z-index:900;pointer-events:none;',
+  floating: 'position:fixed;inset:0;z-index:950;pointer-events:none;',
+}
+
+/** Per-mount child styling: interactive content inside an inert container.
+ * Deliberately NOT inset:0 — a full-viewport child with pointer-events:auto
+ * would sit over the whole page and swallow every click outside its content
+ * (z-index 900 band), freezing interaction for everything below it. The
+ * mount owns its content's size and position (plugins position their own
+ * floating UI); the child is just the container that content renders into. */
+const CHILD_STYLE = 'position:absolute;pointer-events:auto;'
+
+/**
+ * Per-mount error boundary: a crashing plugin mount degrades to a contained
+ * fallback instead of taking down the page (the slot system's
+ * SlotErrorBoundary posture, mirrored for the second root).
+ */
+class MountErrorBoundary extends Component<
+  { children: ReactNode },
+  { crashed: boolean }
+> {
+  override state: { crashed: boolean } = { crashed: false }
+
+  static getDerivedStateFromError(): { crashed: boolean } {
+    return { crashed: true }
+  }
+
+  override componentDidCatch(error: unknown, info: ErrorInfo): void {
+    console.error('ui.mount: plugin render crashed:', error, info.componentStack)
+  }
+
+  override render(): ReactNode {
+    return this.state.crashed ? null : this.props.children
+  }
+}
+
+/**
+ * The generic render-container service. Registered as `ctx.ui`; plugins
+ * declare `inject: ['ui']` and call `ctx.ui.mount(...)` inside a fiber.
+ */
+export class UiMountService extends Service {
+  /** Shared container nodes (lazily created, owned by the service). */
+  private readonly containers = new Map<UiContainerName, HTMLDivElement>()
+
+  /**
+   * @param ctx - owning root context.
+   */
+  constructor(ctx: Context) {
+    super(ctx, 'ui')
+  }
+
+  /**
+   * Mount a plugin UI into an official container. The effect is bound to the
+   * caller's fiber: on fiber unload the mount disposes (root unmounts, child
+   * node removed). Render is lazy — the mount owns no content until
+   * {@link UiMount.render} runs.
+   * @param options - container family and ordering.
+   * @returns the mount handle.
+   */
+  mount(options: UiMountOptions): UiMount {
+    return this._mount(options)
+  }
+
+  /** Implementation arm (the prototype wrapper binds the caller's ctx). */
+  private _mount(options: UiMountOptions): UiMount {
+    const container = this.ensureContainer(options.container)
+    const priority = options.priority ?? 0
+
+    const child = document.createElement('div')
+    child.setAttribute('data-ui-mount', options.container)
+    child.style.cssText = CHILD_STYLE
+    // Priority-ascending insertion: equal priorities keep mount order (append).
+    const siblings = [...container.children]
+    const index = siblings.findIndex(sibling =>
+      Number((sibling as HTMLElement).dataset.uiPriority ?? 0) > priority)
+    if (index === -1) container.appendChild(child)
+    else container.insertBefore(child, siblings[index] as Node)
+    child.dataset.uiPriority = String(priority)
+
+    const root = createRoot(child)
+    // A fresh boundary key per render: getDerivedStateFromError pins a
+    // crashed boundary forever, so a post-crash render() must mount a NEW
+    // boundary to recover (same element type reuses the fiber and its state).
+    let boundaryKey = 0
+    const mount: UiMount = {
+      render: (node) => {
+        boundaryKey += 1
+        root.render(createElement(MountErrorBoundary, { key: boundaryKey, children: node }))
+      },
+      dispose: () => {
+        root.unmount()
+        child.remove()
+      },
+    }
+    return mount
+  }
+
+  /** Lazily create one shared container node under body (owned forever). */
+  private ensureContainer(name: UiContainerName): HTMLDivElement {
+    let node = this.containers.get(name)
+    if (node === undefined) {
+      node = document.createElement('div')
+      node.setAttribute('data-dsh-container', name)
+      node.style.cssText = CONTAINER_STYLE[name]
+      document.body.appendChild(node)
+      this.containers.set(name, node)
+    }
+    return node
+  }
+}
+
+// Prototype method pattern (pairs with the class `declare`): `this.ctx` then
+// resolves to the CALLER's context, so the mount disposes when the plugin
+// fiber unloads — same routing SlotsService.register uses. Element access
+// reaches the private _mount legally.
+;(UiMountService.prototype as { mount: (options: UiMountOptions) => UiMount }).mount
+  = function mount(this: UiMountService, options: UiMountOptions): UiMount {
+    const handle = this['_mount'](options)
+    this.ctx.effect(() => () => { handle.dispose() }, 'ui.mount()')
+    return handle
+  }
