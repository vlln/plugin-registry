+describe('external client rows (registerExternal/unregisterExternal)', () => {
+  /** Write a registry-style client bundle at a caller-chosen path. */
+  function writeExternalBundle(contents = 'module.exports = {}\n'): { id: string; clientPath: string } {
+    root ??= realpathSync(mkdtempSync(join(tmpdir(), 'dsh-client-modules-')))
+    const id = 'acme/greeter'
+    const clientPath = join(root, 'plugins', ...id.split('/'), 'client.js')
+    mkdirSync(dirname(clientPath), { recursive: true })
+    writeFileSync(clientPath, contents)
+    return { id, clientPath }
+  }
+
+  it('adds a row to the graph and serves its bundle through the /plugins route', async () => {
+    const { id, clientPath } = writeExternalBundle('module.exports = { greet: 1 }\n')
+    const { service, route } = constructWithRoute([])
+
+    const rev = service.registerExternal(id, { clientPath })
+
+    expect(service.graph().entries).toHaveLength(1)
+    expect(service.graph().entries[0]).toMatchObject({ id, rev })
+    expect(service.clientPath(id)).toBe(clientPath)
+
+    let status = 0
+    let body = ''
+    const response = {
+      writeHead(nextStatus: number) {
+        status = nextStatus
+        return response
+      },
+      end(chunk?: Uint8Array) {
+        body = chunk === undefined ? '' : Buffer.from(chunk).toString('utf8')
+        return response
+      },
+    } as unknown as ServerResponse
+    await route.handler({
+      method: 'GET',
+      url: `/plugins/${id}/client.js?rev=${rev}`,
+    } as IncomingMessage, response)
+
+    expect(status).toBe(200)
+    expect(body).toBe('module.exports = { greet: 1 }\n')
+  })
+
+  it('replaces an existing row atomically and fires onRebuilt on a rev change', () => {
+    const { id, clientPath } = writeExternalBundle('module.exports = { v: 1 }\n')
+    const { service } = constructWithRoute([])
+    const firstRev = service.registerExternal(id, { clientPath })
+
+    const rebuilt: Array<{ id: string; rev: string }> = []
+    service.onRebuilt((nextId, nextRev) => rebuilt.push({ id: nextId, rev: nextRev }))
+
+    writeFileSync(clientPath, 'module.exports = { v: 2 }\n')
+    const secondRev = service.registerExternal(id, { clientPath })
+
+    expect(secondRev).not.toBe(firstRev)
+    expect(service.graph().entries).toHaveLength(1)
+    expect(rebuilt).toEqual([{ id, rev: secondRev }])
+  })
+
+  it('does not fire onRebuilt when a replacement rev is unchanged', () => {
+    const { id, clientPath } = writeExternalBundle('module.exports = { v: 1 }\n')
+    const { service } = constructWithRoute([])
+    const firstRev = service.registerExternal(id, { clientPath })
+
+    const rebuilt: Array<{ id: string; rev: string }> = []
+    service.onRebuilt((nextId, nextRev) => rebuilt.push({ id: nextId, rev: nextRev }))
+
+    expect(service.registerExternal(id, { clientPath })).toBe(firstRev)
+    expect(rebuilt).toEqual([])
+  })
+
+  it('removes a row from the graph and returns 404 for its bundle', async () => {
+    const { id, clientPath } = writeExternalBundle()
+    const { service, route } = constructWithRoute([])
+    service.registerExternal(id, { clientPath })
+    service.unregisterExternal(id)
+
+    expect(service.graph().entries).toHaveLength(0)
+    expect(service.clientPath(id)).toBeUndefined()
+
+    let status = 0
+    const response = {
+      writeHead(nextStatus: number) {
+        status = nextStatus
+        return response
+      },
+      end() {
+        return response
+      },
+    } as unknown as ServerResponse
+    await route.handler({
+      method: 'GET',
+      url: `/plugins/${id}/client.js`,
+    } as IncomingMessage, response)
+    expect(status).toBe(404)
+  })
+
+  it('unregistering an unknown id is a no-op', () => {
+    writeExternalBundle() // initializes the temp root the service anchors on
+    const { service } = constructWithRoute([])
+    expect(() => { service.unregisterExternal('acme/never-registered') }).not.toThrow()
+    expect(service.graph().entries).toHaveLength(0)
+  })
+
+  it('rejects a malformed id loud before touching the table', () => {
+    const { clientPath } = writeExternalBundle()
+    const { service } = constructWithRoute([])
+    for (const bad of ['NoSlash', '../escape', 'acme/../up', 'acme/name?query', '@scope/name', 'a/b/c']) {
+      expect(() => service.registerExternal(bad, { clientPath })).toThrow(/expected publisher\/name/)
+    }
+    expect(service.graph().entries).toHaveLength(0)
+  })
+})
