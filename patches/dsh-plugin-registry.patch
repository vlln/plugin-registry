diff --git a/packages/client/runtime/tests/task-store.spec.ts b/packages/client/runtime/tests/task-store.spec.ts
new file mode 100644
index 00000000..43f40c0c
--- /dev/null
+++ b/packages/client/runtime/tests/task-store.spec.ts
@@ -0,0 +1,104 @@
+/**
+ * Task snapshot semantics: authoritative replacement after every host-side
+ * change, reconnect re-baselining (session/subscribed clears the mirror),
+ * pre-instantiation buffering, and snapshot reference stability.
+ */
+import { describe, expect, it } from 'vitest'
+import type { MuxFrame, RpcId, SessionId } from '@deepseek-ai/dsh-client-connection/client'
+import { Session } from '../src/client/sessions/session.ts'
+import { SessionManager } from '../src/client/sessions/manager.ts'
+import { FakeApiClient } from './fake-api.ts'
+
+const SID = 'fk-t1' as SessionId
+const rid = (id: string): RpcId => id as RpcId
+
+interface TaskFixture {
+  id: string
+  kind?: string
+  label?: string
+  status?: 'running' | 'stopping' | 'completed' | 'killed' | 'failed'
+  detail?: string
+  finishedAt?: number
+}
+
+/** Build one authoritative task snapshot frame (wire-cropped record). */
+function taskFrame(tasks: TaskFixture[]): MuxFrame {
+  return {
+    type: 'task/snapshot',
+    sessionId: SID,
+    tasks: tasks.map(task => ({
+      id: task.id,
+      kind: task.kind ?? 'bash',
+      label: task.label ?? `sleep ${task.id}`,
+      status: task.status ?? 'running',
+      ...task.detail !== undefined ? { detail: task.detail } : {},
+      startedAt: 1780000000000,
+      ...task.finishedAt !== undefined ? { finishedAt: task.finishedAt } : {},
+    })),
+  }
+}
+
+function makeSession(): Session {
+  return new Session(SID, new FakeApiClient())
+}
+
+describe('task snapshot intake', () => {
+  it('projects the wire-cropped tasks into the conversation snapshot', () => {
+    const session = makeSession()
+    session.handleMuxEnvelope(rid('env-1'), taskFrame([
+      { id: 'bash-1', label: 'compile', detail: 'running' },
+    ]))
+    expect(session.getSnapshot().tasks).toMatchObject([
+      { id: 'bash-1', kind: 'bash', label: 'compile', status: 'running', startedAt: 1780000000000 },
+    ])
+  })
+
+  it('replaces the whole mirror on every frame (snapshot posture, not append)', () => {
+    const session = makeSession()
+    session.handleMuxEnvelope(rid('env-1'), taskFrame([
+      { id: 'bash-1' }, { id: 'bash-2' },
+    ]))
+    session.handleMuxEnvelope(rid('env-2'), taskFrame([
+      { id: 'bash-2', status: 'completed', detail: 'exit code: 0', finishedAt: 1780000001000 },
+    ]))
+    expect(session.getSnapshot().tasks).toEqual([
+      expect.objectContaining({
+        id: 'bash-2', status: 'completed', detail: 'exit code: 0', finishedAt: 1780000001000,
+      }),
+    ])
+  })
+
+  it('keeps the snapshot reference stable until the next frame (memo premise)', () => {
+    const session = makeSession()
+    session.handleMuxEnvelope(rid('env-1'), taskFrame([{ id: 'bash-1' }]))
+    const first = session.getSnapshot().tasks
+    expect(session.getSnapshot().tasks).toBe(first)
+    session.handleMuxEnvelope(rid('env-2'), taskFrame([{ id: 'bash-2' }]))
+    expect(session.getSnapshot().tasks).not.toBe(first)
+  })
+
+  it('clears the mirror on session/subscribed (new mux-generation baseline)', () => {
+    const session = makeSession()
+    session.handleMuxEnvelope(rid('env-1'), taskFrame([{ id: 'bash-1' }]))
+    session.handleMuxEnvelope(rid('env-2'), { type: 'session/subscribed', sessionId: SID, lastSeq: 5 })
+    expect(session.getSnapshot().tasks).toEqual([])
+  })
+})
+
+describe('task snapshot buffering and re-baseline (manager)', () => {
+  it('buffers task/snapshot frames for a not-yet-instantiated session, replacing priors', () => {
+    const manager = new SessionManager(new FakeApiClient())
+    // Not instantiated: the frame must buffer, not drop.
+    manager.handleMuxEnvelope({ rpcId: rid('m-1'), payload: taskFrame([{ id: 'bash-1' }]) })
+    manager.handleMuxEnvelope({ rpcId: rid('m-2'), payload: taskFrame([{ id: 'bash-2' }]) })
+    expect(manager.get(SID).getSnapshot().tasks).toMatchObject([{ id: 'bash-2' }])
+  })
+
+  it('drops buffered task/snapshot frames on session/subscribed (host will resend the live snapshot)', () => {
+    const manager = new SessionManager(new FakeApiClient())
+    manager.handleMuxEnvelope({ rpcId: rid('m-1'), payload: taskFrame([{ id: 'bash-1' }]) })
+    manager.handleMuxEnvelope({ rpcId: rid('m-2'), payload: { type: 'session/subscribed', sessionId: SID, lastSeq: 0 } })
+    // The buffered snapshot belongs to the previous mux generation.
+    expect(manager.get(SID).getSnapshot().tasks).toEqual([])
+  })
+})
diff --git a/packages/client/runtime/tests/ui-mount.spec.tsx b/packages/client/runtime/tests/ui-mount.spec.tsx
new file mode 100644
index 00000000..333d9013
--- /dev/null
+++ b/packages/client/runtime/tests/ui-mount.spec.tsx
@@ -0,0 +1,147 @@
+// @vitest-environment jsdom
+/**
+ * UiMountService terminal design: lazily created shared containers, per-mount
+ * independent roots, priority ordering, fiber-bound disposal, error-boundary
+ * isolation, and the inert-container contract.
+ */
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { act, cleanup, screen } from '@testing-library/react'
+import { Context } from 'cordis'
+import type { ReactNode } from 'react'
+import { UiMountService } from '../src/client/ui-mount.ts'
+
+afterEach(() => {
+  cleanup()
+  document.body.innerHTML = ''
+})
+
+function harness(): { ctx: Context; ui: UiMountService } {
+  // The Service constructor registers `ctx.ui`; direct construction is enough.
+  const ctx = new Context()
+  const ui = new UiMountService(ctx)
+  return { ctx, ui }
+}
+
+const overlay = () => document.querySelector('[data-dsh-container="overlay"]')
+const floating = () => document.querySelector('[data-dsh-container="floating"]')
+
+describe('UiMountService containers', () => {
+  it('lazily creates one shared container node per family and reuses it across mounts', () => {
+    const { ui } = harness()
+    expect(overlay()).toBeNull()
+    const m1 = ui.mount({ container: 'overlay' })
+    const m2 = ui.mount({ container: 'overlay' })
+    ui.mount({ container: 'floating' })
+    expect(overlay()).not.toBeNull()
+    expect(floating()).not.toBeNull()
+    // One shared container, two per-mount children, both owned by the container.
+    expect(overlay()!.children.length).toBe(2)
+    expect(overlay()!.children[0]).not.toBe(overlay()!.children[1])
+    m1.dispose()
+    m2.dispose()
+    // The shared container stays after mounts dispose (service-owned).
+    expect(overlay()).not.toBeNull()
+    expect(overlay()!.children.length).toBe(0)
+  })
+
+  it('sorts children by priority ascending, ties by mount order', () => {
+    const { ui } = harness()
+    const late = ui.mount({ container: 'overlay', priority: 10 })
+    act(() => { late.render(<span data-testid="late">L</span>) })
+    const early = ui.mount({ container: 'overlay', priority: 0 })
+    act(() => { early.render(<span data-testid="early">E</span>) })
+    const same = ui.mount({ container: 'overlay', priority: 0 })
+    act(() => { same.render(<span data-testid="same">S</span>) })
+    // DOM order follows ascending priority; equal priorities keep mount order.
+    const textOrder = [...overlay()!.children].map(child => child.textContent)
+    expect(textOrder).toEqual(['E', 'S', 'L'])
+    late.dispose()
+    early.dispose()
+    same.dispose()
+  })
+
+  it('keeps an empty container inert (pointer-events none) with interactive children', () => {
+    const { ui } = harness()
+    ui.mount({ container: 'overlay' })
+    expect((overlay() as HTMLElement).style.pointerEvents).toBe('none')
+    const child = overlay()!.children[0] as HTMLElement
+    expect(child.style.pointerEvents).toBe('auto')
+  })
+
+  it('a mount child never spans the full viewport (it would swallow every click)', () => {
+    // Regression: a per-mount child with inset:0 + pointer-events:auto sits
+    // over the whole page at z-index 900 and freezes every component below
+    // it — only same-band, later-DOM nodes (a plugin's own bar) stay clickable.
+    const { ui } = harness()
+    ui.mount({ container: 'overlay' })
+    const child = overlay()!.children[0] as HTMLElement
+    expect(child.style.cssText).not.toContain('inset:0')
+    expect(child.style.position).toBe('absolute')
+  })
+})
+
+describe('UiMountService render and disposal', () => {
+  it('renders into the per-mount root and unmounts on dispose', () => {
+    const { ui } = harness()
+    const mount = ui.mount({ container: 'overlay' })
+    act(() => { mount.render(<span data-testid="panel">hello</span>) })
+    expect(screen.getByTestId('panel').textContent).toBe('hello')
+    act(() => { mount.dispose() })
+    expect(screen.queryByTestId('panel')).toBeNull()
+    expect(overlay()!.children.length).toBe(0)
+  })
+
+  it('a replacing render swaps the mounted content', () => {
+    const { ui } = harness()
+    const mount = ui.mount({ container: 'overlay' })
+    act(() => { mount.render(<span data-testid="a">first</span>) })
+    act(() => { mount.render(<span data-testid="b">second</span>) })
+    expect(screen.queryByTestId('a')).toBeNull()
+    expect(screen.getByTestId('b').textContent).toBe('second')
+    act(() => { mount.dispose() })
+  })
+
+  it('isolates a crashing mount: the boundary swallows it, siblings and page stay intact', () => {
+    const { ui } = harness()
+    const spy = vi.spyOn(console, 'error').mockImplementation(() => {})
+    const boom = ui.mount({ container: 'overlay', priority: 0 })
+    const healthy = ui.mount({ container: 'overlay', priority: 1 })
+    const Crasher = (): ReactNode => { throw new Error('mount boom') }
+    act(() => { boom.render(<Crasher />) })
+    act(() => { healthy.render(<span data-testid="ok">fine</span>) })
+    expect(screen.queryByText('mount boom')).toBeNull()
+    expect(screen.getByTestId('ok').textContent).toBe('fine')
+    expect(spy.mock.calls.some(([msg]) => String(msg).includes('ui.mount: plugin render crashed'))).toBe(true)
+    spy.mockRestore()
+    act(() => { boom.dispose() })
+    act(() => { healthy.dispose() })
+  })
+
+  it('recovers after a crash: the next render mounts a fresh boundary', () => {
+    const { ui } = harness()
+    const spy = vi.spyOn(console, 'error').mockImplementation(() => {})
+    const mount = ui.mount({ container: 'overlay' })
+    const Crasher = (): ReactNode => { throw new Error('mount boom') }
+    act(() => { mount.render(<Crasher />) })
+    expect(overlay()!.children[0]!.textContent).toBe('')
+    // A subsequent render with healthy content must NOT be swallowed by the
+    // crashed boundary's pinned state (fresh key per render).
+    act(() => { mount.render(<span data-testid="recovered">ok</span>) })
+    expect(screen.getByTestId('recovered').textContent).toBe('ok')
+    spy.mockRestore()
+    mount.dispose()
+  })
+
+  it('disposes with the contributing fiber (HMR safety)', async () => {
+    const { ctx } = harness()
+    const fiber = await ctx.plugin(Object.assign((inner: Context) => {
+      const mount = inner.ui.mount({ container: 'overlay' })
+      mount.render(<span data-testid="fiber">live</span>)
+    }, { inject: ['ui'] }))
+    // React 18 root render commits asynchronously outside act: await it.
+    expect((await screen.findByTestId('fiber')).textContent).toBe('live')
+    await act(async () => { await fiber.dispose() })
+    expect(screen.queryByTestId('fiber')).toBeNull()
+    expect(overlay()!.children.length).toBe(0)
+  })
+})
