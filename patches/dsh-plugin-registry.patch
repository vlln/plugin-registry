+/**
+ * plugins domain contract: the web face of the local plugin registry
+ * (`ctx.plugins`, provided by `@deepseek-ai/dsh-plugin`). Rows merge the local
+ * catalog (the browse list) with installed state; install/enable/disable/
+ * uninstall operate on the registry, and enable/disable keep the live mount
+ * set in sync — a toggled plugin mounts or unmounts immediately.
+ */
+
+import type { RpcRequest, RpcResponse } from './rpc.ts'
+
+/** One plugin browse row (wire projection of the registry's PluginEntryView). */
+export interface PluginEntryView {
+  /** Publisher-scoped plugin id. */
+  readonly id: string
+  /** Installed version when installed, else the catalog-advertised version. */
+  readonly version: string
+  /** One-line summary. */
+  readonly description: string
+  /** Whether the plugin is installed in the registry. */
+  readonly installed: boolean
+  /** Whether the installed plugin is mounted (and will mount on the next load). */
+  readonly enabled: boolean
+}
+
+/** One plugin id addressed by every mutating method. */
+export interface PluginIdPayload {
+  /** The plugin id. */
+  readonly id: string
+}
+
+/** Plugin-domain unary methods (the map keys plugin.* of RpcMethodMap). */
+export interface PluginsApi {
+  /** List every browse row: catalog entries merged with installed state, sorted by id. */
+  list(request: RpcRequest<{}>): Promise<RpcResponse<{ plugins: readonly PluginEntryView[] }>>
+  /** Install a catalog entry (disabled by default; not mounted). */
+  install(request: RpcRequest<PluginIdPayload>): Promise<RpcResponse<{ id: string }>>
+  /** Enable an installed plugin and mount it immediately. */
+  enable(request: RpcRequest<PluginIdPayload>): Promise<RpcResponse<{ id: string }>>
+  /** Unmount and disable an installed plugin. */
+  disable(request: RpcRequest<PluginIdPayload>): Promise<RpcResponse<{ id: string }>>
+  /** Unmount and remove an installed plugin from the registry. */
+  uninstall(request: RpcRequest<PluginIdPayload>): Promise<RpcResponse<{ id: string }>>
+}
