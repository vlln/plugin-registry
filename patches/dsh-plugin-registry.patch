diff --git a/packages/client/ui-conversation/tests/chat-item-chain.spec.tsx b/packages/client/ui-conversation/tests/chat-item-chain.spec.tsx
new file mode 100644
index 00000000..3d050b39
--- /dev/null
+++ b/packages/client/ui-conversation/tests/chat-item-chain.spec.tsx
@@ -0,0 +1,226 @@
+// @vitest-environment jsdom
+/**
+ * The per-flow-item takeover chain (S3): ChatView dispatches every flow item
+ * through `conversation.chat.item` — entry selectors judge the item, the
+ * first match renders instead of the official row, and an all-decline falls
+ * back to the official rendering. The chain election machinery itself is
+ * covered by ui-slots' scoped-slots specs; this spec pins the ChatView
+ * integration: per-item calls, owner currency, mixed takeover, and selector
+ * crash degradation.
+ */
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, render } from '@testing-library/react'
+import type { ReactNode } from 'react'
+import type {
+  AssistantMessageNode, ConversationSnapshot, SessionId, SessionListState, ToolResultNode,
+  UserMessageNode, WorkspaceListState,
+} from '@deepseek-ai/dsh-client-runtime/client'
+import { bindSnapshotSelector } from '@deepseek-ai/dsh-client-web-react'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-runtime/client'
+import type { ChatFlowItemOwnerProps, ChatViewSlotProps } from '../src/client/contract/slots.ts'
+import type { ChatFlowItem } from '../src/client/chat/chat-flow.ts'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { zh as commonZh } from '@deepseek-ai/dsh-client-locale/src/locales/zh.ts'
+import { createChatStore } from '../src/client/stores.ts'
+import { ChatView } from '../src/client/chat/ChatView.tsx'
+import { zh } from '../src/client/locales.ts'
+
+const SID = 's1' as SessionId
+
+afterEach(() => { cleanup() })
+
+function snapshotBase(): ConversationSnapshot {
+  return {
+    sessionId: SID, nodes: [], turnTimings: new Map(), turnEnds: new Map(), partial: null,
+    runningCalls: [], codeDispatches: new Map(), pending: [], queue: [], tasks: [],
+    running: false, subagent: null, composerPhase: 'active', removed: false,
+    openState: 'open', openError: null, hasMore: false, loadingOlder: false,
+    promptError: null, blank: false, lastAgentError: null,
+  }
+}
+
+function makeSource(init?: Partial<ConversationSnapshot>) {
+  let snap: ConversationSnapshot = { ...snapshotBase(), ...init }
+  const subs = new Set<() => void>()
+  return {
+    set: (next: Partial<ConversationSnapshot>) => {
+      snap = { ...snap, ...next }
+      for (const fn of [...subs]) fn()
+    },
+    source: {
+      getSnapshot: () => snap,
+      subscribe: (fn: () => void) => {
+        subs.add(fn)
+        return () => subs.delete(fn)
+      },
+    },
+  }
+}
+
+const user = (seq: number, text: string): UserMessageNode => ({
+  kind: 'user', seq, time: seq * 1000, content: [{ type: 'text', text }] as never, source: null,
+})
+const assistant = (seq: number, text: string, turn = 1): AssistantMessageNode => ({
+  kind: 'assistant', seq, time: seq * 1_000, turn, step: 1, blocks: [{ kind: 'text', text }],
+})
+const toolResult = (seq: number, callId: string, name = 'bash', turn = 1): ToolResultNode => ({
+  kind: 'tool-result', seq, time: seq * 1_000, turn, callId,
+  call: { name, argsRaw: `{"command":"cmd-${callId}"}` },
+  callTime: seq * 1_000 - 500,
+  content: [], isError: false, callView: null, resultView: null,
+})
+
+function emptySessions() {
+  const store = createSnapshotStore<SessionListState>(
+    { ids: [], byId: {}, current: undefined, phase: 'ready', subagentsByParent: {}, currentAddress: undefined })
+  return bindSnapshotSelector(store)
+}
+function emptyWorkspaces() {
+  const store = createSnapshotStore<WorkspaceListState>({
+    items: [], archivedSessionIds: [], state: 'idle', phase: 'ready', error: null,
+    baselinesReady: true, recentWorkspaceId: undefined,
+  })
+  return bindSnapshotSelector(store)
+}
+
+interface ChainEntry {
+  select: (owner: ChatFlowItemOwnerProps) => unknown
+  component: (props: { item: ChatFlowItem; matched: unknown }) => ReactNode
+}
+
+/**
+ * Minimal per-item chain dispatch mirroring renderSlotChain's contract:
+ * selectors run in order over the owner; the first non-null match renders
+ * with `matched` injected; all-decline renders the fallback.
+ */
+function makeHarness(init?: Partial<ConversationSnapshot>, entries: ChainEntry[] = []) {
+  const { set, source } = makeSource(init)
+  const chat = createChatStore().create()
+  const renderSlot = ((_key: string, _owner: object, opts?: { fallback?: ReactNode }) =>
+    opts?.fallback ?? null) as unknown as ChatViewSlotProps['renderSlot']
+  const calls: ChatFlowItemOwnerProps[] = []
+  const renderSlotChain = ((key: string, owner: ChatFlowItemOwnerProps, opts?: { fallback?: ReactNode }) => {
+    expect(key).toBe('conversation.chat.item')
+    calls.push(owner)
+    for (const entry of entries) {
+      let matched: unknown
+      try {
+        matched = entry.select(owner)
+      } catch {
+        continue // selector crash degrades to a decline (scoped-slots contract)
+      }
+      if (matched !== null) return entry.component({ item: owner.item, matched })
+    }
+    return opts?.fallback ?? null
+  }) as unknown as ChatViewSlotProps['renderSlotChain']
+  const SessionProviderStub: ChatViewSlotProps['SessionProvider'] = ({ children }) => <>{children(SID)}</>
+  const props: ChatViewSlotProps = {
+    sessionId: SID,
+    useSession: bindSnapshotSelector(source),
+    useSessions: emptySessions(),
+    useWorkspaces: emptyWorkspaces(),
+    useProjection: (() => undefined),
+    useTasks: (() => []) as never,
+    useInput: (() => { throw new Error('unused') }),
+    inputActions: { setDraft: () => {}, submit: () => {} },
+    useStore: bindSnapshotSelector(chat),
+    actions: chat.actions,
+    renderSlot,
+    renderSlotChain,
+    SessionProvider: SessionProviderStub,
+    openDetails: () => {},
+    openFile: () => {},
+    loadOlder: () => {},
+    inspectCall: () => {},
+    chatScroll: { save: () => {}, read: () => null },
+    forkAt: () => {},
+    t: makeTranslate(zh, commonZh),
+  }
+  return { set, ChatView, props, calls }
+}
+
+describe('conversation.chat.item per-item takeover chain', () => {
+  it('dispatches every flow item through the chain with the item as owner, empty ledger falls back to official', () => {
+    const h = makeHarness({ nodes: [user(1, 'q'), assistant(2, 'answer'), toolResult(3, 'c1')] })
+    const view = render(<h.ChatView {...h.props} />)
+    // One call per flow item (user, assistant, tool-group), in flow order.
+    expect(h.calls.map(c => c.item.key)).toEqual(['n1', 'n2', 'g3'])
+    // No registrants: the official rows all render.
+    expect(view.getByText('q')).toBeTruthy()
+    expect(view.getByText('answer')).toBeTruthy()
+    expect(view.getByText('cmd-c1')).toBeTruthy()
+  })
+
+  it('takes over only matching items: mixed takeover with official fallback for the rest', () => {
+    const taken: string[] = []
+    const h = makeHarness(
+      { nodes: [user(1, 'q'), assistant(2, 'answer'), toolResult(3, 'c1')] },
+      [{
+        // Fold every completed tool-group into one line (turn-folding shape).
+        select: (owner: ChatFlowItemOwnerProps) => owner.item.kind === 'tool-group' ? { folded: true } : null,
+        component: ({ item, matched }) => {
+          taken.push(item.key)
+          return <button data-folded="1">{String((matched as { folded: boolean }).folded)}</button>
+        },
+      }],
+    )
+    const view = render(<h.ChatView {...h.props} />)
+    expect(taken).toEqual(['g3'])
+    // The taken item renders the entry; the others stay official.
+    expect(view.container.querySelector('[data-folded="1"]')).not.toBeNull()
+    expect(view.getByText('q')).toBeTruthy()
+    expect(view.getByText('answer')).toBeTruthy()
+    // The official tool-group never rendered (tool call label suppressed).
+    expect(view.queryByText('cmd-c1')).toBeNull()
+  })
+
+  it('degrades a throwing selector to a decline and renders the official row', () => {
+    const spy = vi.spyOn(console, 'error').mockImplementation(() => {})
+    const h = makeHarness(
+      { nodes: [assistant(2, 'answer')] },
+      [{
+        select: () => { throw new Error('selector boom') },
+        component: () => <b>never</b>,
+      }],
+    )
+    const view = render(<h.ChatView {...h.props} />)
+    expect(view.getByText('answer')).toBeTruthy()
+    expect(view.container.textContent).not.toContain('never')
+    spy.mockRestore()
+  })
+
+  it('carries the turn context in every owner: ended turns, answer seqs, and the group turn', () => {
+    // One ended turn with a mid-turn narration, a tool group, and a final answer.
+    const h = makeHarness({
+      nodes: [user(1, 'q'), assistant(2, 'mid narration', 1), toolResult(3, 'c1', 'bash', 1), assistant(4, 'answer', 1)],
+      turnEnds: new Map([[1, 10]]),
+    })
+    render(<h.ChatView {...h.props} />)
+    const groupOwner = h.calls.find(c => c.item.kind === 'tool-group')
+    expect(groupOwner?.item).toMatchObject({ kind: 'tool-group', turn: 1 })
+    // The owner carries the ended-turn map and the per-turn answer seqs, so a
+    // selector can judge "execution process of an ended turn" purely.
+    expect(groupOwner?.turnEnds.has(1)).toBe(true)
+    expect(groupOwner?.answerSeqs.has(4)).toBe(true)
+    expect(groupOwner?.answerSeqs.has(2)).toBe(false)
+    // Every flow item (not only groups) receives the same turn context.
+    for (const call of h.calls) {
+      expect(call.turnEnds).toBeDefined()
+      expect(call.answerSeqs).toBeDefined()
+    }
+  })
+
+  it('an all-decline pass leaves the official item untouched', () => {
+    const h = makeHarness(
+      { nodes: [user(1, 'q'), toolResult(2, 'c1')] },
+      [{
+        select: () => null,
+        component: () => <b>never</b>,
+      }],
+    )
+    const view = render(<h.ChatView {...h.props} />)
+    expect(view.getByText('q')).toBeTruthy()
+    expect(view.getByText('cmd-c1')).toBeTruthy()
+    expect(view.container.textContent).not.toContain('never')
+  })
+})
