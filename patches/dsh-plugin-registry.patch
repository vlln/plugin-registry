diff --git a/apps/cli/src/plugin.ts b/apps/cli/src/plugin.ts
new file mode 100644
index 00000000..57dfce62
--- /dev/null
+++ b/apps/cli/src/plugin.ts
@@ -0,0 +1,90 @@
+/**
+ * `dsh plugin` — manage the local plugin registry: install from a directory,
+ * list, enable/disable, and uninstall. Pure filesystem operations against the
+ * registry under `$DSH_HOME/plugins`; no harness boot.
+ * @module @deepseek-ai/dsh/plugin
+ */
+
+import { resolveDshHome } from '@deepseek-ai/dsh-paths'
+import {
+  installFromTarball,
+  installPlugin,
+  isTarball,
+  listPlugins,
+  requireDirectory,
+  scaffoldPlugin,
+  setEnabled,
+  uninstallPlugin,
+} from '@deepseek-ai/dsh-plugin'
+import { join } from 'node:path'
+import type { PluginInvocation } from './args.ts'
+
+/**
+ * Run one plugin-registry action and print its outcome. Domain failures print
+ * to stderr and set the exit code instead of throwing, so a mistyped id or a
+ * bad manifest never surfaces a stack trace.
+ * @param invocation - the resolved plugin subcommand.
+ * @param harnessVersion - the running dsh version, checked against `engines.dsh` at install.
+ */
+export async function runPlugin(invocation: PluginInvocation, harnessVersion: string): Promise<void> {
+  try {
+    const dshHome = resolveDshHome()
+    switch (invocation.action) {
+      case 'install': {
+        if (invocation.path === undefined) throw new Error('dsh plugin install needs a plugin directory or tarball')
+        const installed = isTarball(invocation.path)
+          ? await installFromTarball(invocation.path, { dshHome, harnessVersion })
+          : await (async () => {
+            await requireDirectory(invocation.path as string)
+            return installPlugin(invocation.path as string, { dshHome, harnessVersion })
+          })()
+        console.log(`installed ${installed.id}@${installed.record.version} (disabled; run \`dsh plugin enable ${installed.id}\` to activate)`)
+        break
+      }
+      case 'create': {
+        if (invocation.id === undefined) throw new Error('dsh plugin create needs a plugin id (publisher/name)')
+        const name = invocation.id.split('/').at(-1) ?? invocation.id
+        const dir = await scaffoldPlugin({ id: invocation.id, dir: join(process.cwd(), name) })
+        console.log(`created plugin ${invocation.id} in ${dir}; run \`dsh plugin install ${dir}\` to install it`)
+        break
+      }
+      case 'list': {
+        const listed = await listPlugins(dshHome)
+        if (listed.length === 0) {
+          console.log('no plugins installed')
+          break
+        }
+        for (const plugin of listed) {
+          const state = plugin.record.enabled ? 'enabled ' : 'disabled'
+          const summary = plugin.manifest.description ? ` — ${plugin.manifest.description}` : ''
+          console.log(`${state} ${plugin.id}@${plugin.record.version}${summary}`)
+        }
+        break
+      }
+      case 'enable': {
+        if (invocation.id === undefined) throw new Error('dsh plugin enable needs a plugin id')
+        await setEnabled(dshHome, invocation.id, true)
+        console.log(`enabled ${invocation.id}`)
+        break
+      }
+      case 'disable': {
+        if (invocation.id === undefined) throw new Error('dsh plugin disable needs a plugin id')
+        await setEnabled(dshHome, invocation.id, false)
+        console.log(`disabled ${invocation.id}`)
+        break
+      }
+      case 'uninstall': {
+        if (invocation.id === undefined) throw new Error('dsh plugin uninstall needs a plugin id')
+        await uninstallPlugin(dshHome, invocation.id)
+        console.log(`uninstalled ${invocation.id}`)
+        break
+      }
+      default:
+        invocation.action satisfies never
+    }
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error)
+    console.error(`dsh plugin ${invocation.action}: ${message}`)
+    process.exitCode = 1
+  }
+}
