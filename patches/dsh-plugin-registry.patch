diff --git a/packages/host/apiproxy/tests/api-proxy-plugins.spec.ts b/packages/host/apiproxy/tests/api-proxy-plugins.spec.ts
new file mode 100644
index 00000000..8ad8836b
--- /dev/null
+++ b/packages/host/apiproxy/tests/api-proxy-plugins.spec.ts
@@ -0,0 +1,150 @@
+/**
+ * plugins-domain handler tests: browse list, install, enable (with live
+ * mount), disable (with live unmount), and uninstall against a real
+ * `ctx.plugins` service on a temp harness home.
+ */
+
+import { mkdtemp, mkdir, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import { Context } from 'cordis'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import SessionStore from '@deepseek-ai/dsh-session'
+import UserInteractionService from '@deepseek-ai/dsh-user-interaction'
+import { createApiProxy } from '../src/api-proxy.ts'
+import { RpcId, type RpcRequest, type RpcResponse } from '../src/api/rpc.ts'
+import { MANIFEST_FILE_NAME, PluginLocalService } from '@deepseek-ai/dsh-plugin'
+
+declare module 'cordis' {
+  interface Events {
+    'plugin/api-test'(value: string): void
+  }
+}
+
+let nextRpc = 1
+
+function request<P>(payload: P): RpcRequest<P> {
+  return { rpcId: RpcId(`req-${String(nextRpc++)}`), payload }
+}
+
+function expectOk<T>(response: RpcResponse<T>): T {
+  expect(response.result.ok).toBe(true)
+  if (!response.result.ok) throw new Error('unreachable')
+  return response.result.value
+}
+
+function expectErr(response: RpcResponse<unknown>): string {
+  expect(response.result.ok).toBe(false)
+  if (response.result.ok) throw new Error('unreachable')
+  return response.result.error.message
+}
+
+const ENTRY = `
+export default {
+  name: 'api-entry',
+  apply(ctx) {
+    ctx.on('plugin/api-test', (value) => { globalThis.__dshPluginApiTest = value })
+  },
+}
+`
+
+let tempDir: string
+let dshHome: string
+let ctx: Context
+let api: ReturnType<typeof createApiProxy>
+let dispose: () => Promise<void>
+let sequence = 0
+
+async function writeSource(root: string, id: string): Promise<void> {
+  await mkdir(root, { recursive: true })
+  await writeFile(join(root, MANIFEST_FILE_NAME), JSON.stringify({ id, version: '0.1.0', main: './index.mjs' }))
+  await writeFile(join(root, 'index.mjs'), ENTRY)
+}
+
+beforeEach(async () => {
+  tempDir = await mkdtemp(join(tmpdir(), 'dsh-apiproxy-plugin-'))
+  dshHome = join(tempDir, 'home')
+  await mkdir(dshHome, { recursive: true })
+  sequence += 1
+
+  ctx = new Context()
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(UserInteractionService)
+  await ctx.plugin(AgentRegistry)
+  const service = new PluginLocalService(ctx, dshHome, '0.2.0')
+  api = createApiProxy(ctx, { provider: 'p', model: 'm', cwd: '/tmp', workspaceRoot: '/tmp' })
+  dispose = () => service.dispose()
+})
+
+afterEach(async () => {
+  delete (globalThis as Record<string, unknown>).__dshPluginApiTest
+  await dispose()
+  await rm(tempDir, { recursive: true, force: true })
+})
+
+async function writeCatalog(entries: Array<{ id: string; description?: string; version?: string; source: string }>): Promise<void> {
+  await writeFile(join(dshHome, 'plugins-catalog.json'), JSON.stringify(entries))
+}
+
+describe('plugins.list', () => {
+  it('lists catalog rows with install and enable state', async () => {
+    const id = `acme/listed-${sequence}`
+    const source = join(tempDir, 'src-listed')
+    await writeSource(source, id)
+    await writeCatalog([{ id, description: 'listed', version: '0.1.0', source }])
+
+    const value = expectOk(await api.plugins.list(request({})))
+    expect(value.plugins).toEqual([
+      { id, version: '0.1.0', description: 'listed', installed: false, enabled: false },
+    ])
+  })
+
+  it('reports a missing registry service as a composition gap', async () => {
+    const bareCtx = new Context()
+    await bareCtx.plugin(SessionStore)
+    await bareCtx.plugin(UserInteractionService)
+    await bareCtx.plugin(AgentRegistry)
+    const bare = createApiProxy(bareCtx, { provider: 'p', model: 'm', cwd: '/tmp', workspaceRoot: '/tmp' })
+    const message = expectErr(await bare.plugins.list(request({})))
+    expect(message).toContain('does not mount @deepseek-ai/dsh-plugin')
+  })
+})
+
+describe('plugins install/enable/disable/uninstall', () => {
+  it('installs disabled, then enables with a live mount', async () => {
+    const id = `acme/live-${sequence}`
+    const source = join(tempDir, 'src-live')
+    await writeSource(source, id)
+    await writeCatalog([{ id, version: '0.1.0', source }])
+
+    expect(expectOk(await api.plugins.install(request({ id })))).toEqual({ id })
+    const listed = expectOk(await api.plugins.list(request({})))
+    expect(listed.plugins[0]).toMatchObject({ id, installed: true, enabled: false })
+
+    expect(expectOk(await api.plugins.enable(request({ id })))).toEqual({ id })
+    ctx.emit('plugin/api-test', 'mounted-live')
+    expect((globalThis as Record<string, unknown>).__dshPluginApiTest).toBe('mounted-live')
+
+    expect(expectOk(await api.plugins.disable(request({ id })))).toEqual({ id })
+    delete (globalThis as Record<string, unknown>).__dshPluginApiTest
+    ctx.emit('plugin/api-test', 'unmounted')
+    expect((globalThis as Record<string, unknown>).__dshPluginApiTest).toBeUndefined()
+
+    expect(expectOk(await api.plugins.uninstall(request({ id })))).toEqual({ id })
+    const after = expectOk(await api.plugins.list(request({})))
+    expect(after.plugins).toEqual([
+      { id, version: '0.1.0', description: '', installed: false, enabled: false },
+    ])
+  })
+
+  it('fails loud when enabling an unknown plugin', async () => {
+    const message = expectErr(await api.plugins.enable(request({ id: 'acme/ghost' })))
+    expect(message).toContain('not installed')
+  })
+
+  it('fails loud when installing an id absent from the catalog', async () => {
+    const message = expectErr(await api.plugins.install(request({ id: 'acme/ghost' })))
+    expect(message).toContain('not in the catalog')
+  })
+})
diff --git a/packages/host/apiproxy/tests/api-proxy-task.spec.ts b/packages/host/apiproxy/tests/api-proxy-task.spec.ts
new file mode 100644
index 00000000..35919f4a
--- /dev/null
+++ b/packages/host/apiproxy/tests/api-proxy-task.spec.ts
@@ -0,0 +1,152 @@
+/**
+ * Task projection carrier path of the host ApiProxy: task registration and
+ * settlement push `task/snapshot` frames carrying the owner session's full
+ * live list; unowned tasks never project.
+ */
+import { describe, expect, it } from 'vitest'
+import { Context } from 'cordis'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import SessionStore, { Session, SessionId } from '@deepseek-ai/dsh-session'
+import UserInteractionService from '@deepseek-ai/dsh-user-interaction'
+import type { TaskHooks, TaskOutcome, TaskStart } from '@deepseek-ai/dsh-tasks'
+import LocalTaskService from '@deepseek-ai/dsh-tasks-local'
+import type { MuxFrame, RpcRequest } from '@deepseek-ai/dsh-host-apiproxy/api'
+import { RpcId } from '@deepseek-ai/dsh-host-apiproxy/api/rpc'
+import { createApiProxy } from '@deepseek-ai/dsh-host-apiproxy'
+
+const agentScopeDisposers = new WeakMap<Agent, () => Promise<void>>()
+
+function stubAgent(ctx: Context, rawId: string): Agent {
+  const id = SessionId(rawId)
+  const scopeFiber = ctx.plugin(() => {})
+  const agent = {
+    id,
+    options: {},
+    session: Session.create(id),
+    status: 'idle' as const,
+    acceptsNextStep: false,
+    ctx: scopeFiber.ctx,
+    followup: () => {},
+    steer: () => ({ outcome: Promise.resolve({ status: 'rejected' as const }) }),
+    inject: () => {},
+    send: () => {},
+    updateInbox: (): 'not-found' => 'not-found',
+    reserveTurnAdmission: () => undefined,
+    cancel() {},
+    whenIdle() { return Promise.resolve() },
+  }
+  agentScopeDisposers.set(agent, async () => { await scopeFiber.dispose() })
+  return agent
+}
+
+/** A controllable producer start-spec: settle its `done` on demand. */
+function producer(owner?: Agent) {
+  let settle!: (outcome: TaskOutcome) => void
+  const hooks: TaskHooks = {
+    cancel() {},
+    done: new Promise<TaskOutcome>((resolve) => { settle = resolve }),
+  }
+  const spec: TaskStart = {
+    kind: 'bash',
+    label: 'sleep 60',
+    ...owner !== undefined ? { owner } : {},
+    run: () => hooks,
+  }
+  return { spec, settle }
+}
+
+async function harness(): Promise<{ ctx: Context; agent: Agent; ownerSession: SessionId }> {
+  const ctx = new Context()
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(UserInteractionService)
+  await ctx.plugin(LocalTaskService)
+  ctx.tasks.attachSurface('test-surface')
+  const agent = stubAgent(ctx, 'session-task-owner')
+  ctx.agents.register(agent)
+  return { ctx, agent, ownerSession: agent.id }
+}
+
+describe('task/snapshot push frames', () => {
+  /** Drain frames until the mux stream settles or `count` task frames arrived. */
+  async function collectTaskFrames(
+    stream: AsyncIterable<RpcRequest<MuxFrame>>,
+    count: number,
+    abort: AbortController,
+  ): Promise<Extract<MuxFrame, { type: 'task/snapshot' }>[]> {
+    const frames: Extract<MuxFrame, { type: 'task/snapshot' }>[] = []
+    for await (const envelope of stream) {
+      const frame = envelope.payload
+      if (frame.type === 'task/snapshot') {
+        frames.push(frame)
+        if (frames.length >= count) abort.abort()
+      }
+    }
+    return frames
+  }
+
+  it('broadcasts the owner session list on registration and settlement; unowned tasks never project', async () => {
+    const { ctx, agent, ownerSession } = await harness()
+    const proxy = createApiProxy(ctx, { provider: 'p', model: 'm', cwd: '/tmp', workspaceRoot: '/tmp' })
+    // The gateway's onChanged subscription lives in an inject child whose
+    // fiber activates asynchronously; yield until it lands before starting.
+    await new Promise(resolve => setTimeout(resolve, 0))
+    const abort = new AbortController()
+    const stream = proxy.events.mux({ rpcId: RpcId('t-task-mux'), payload: {} }, abort.signal)
+    const collected = collectTaskFrames(stream, 2, abort)
+
+    // Unowned task: no session to address — must not produce a frame.
+    const unowned = producer()
+    ctx.tasks.start(unowned.spec)
+    // Owned task: registration pushes the running list; settlement pushes the terminal list.
+    const owned = producer(agent)
+    const id = ctx.tasks.start(owned.spec)
+    owned.settle({ status: 'completed', detail: 'exit code: 0' })
+    await new Promise(resolve => setTimeout(resolve, 0))
+
+    const frames = await collected
+    expect(frames).toHaveLength(2)
+    expect(frames[0]).toEqual({
+      type: 'task/snapshot',
+      sessionId: ownerSession,
+      tasks: [expect.objectContaining({ id, kind: 'bash', label: 'sleep 60', status: 'running' })],
+    })
+    expect(frames[1]).toEqual({
+      type: 'task/snapshot',
+      sessionId: ownerSession,
+      tasks: [expect.objectContaining({ id, status: 'completed', detail: 'exit code: 0' })],
+    })
+    expect(frames[1]?.tasks[0]?.finishedAt).toBeTypeOf('number')
+  })
+
+  it('baselines running tasks on mux open: work started before the stream never goes invisible', async () => {
+    const ctx = new Context()
+    await ctx.plugin(SessionStore)
+    await ctx.plugin(AgentRegistry)
+    await ctx.plugin(UserInteractionService)
+    await ctx.plugin(LocalTaskService)
+    ctx.tasks.attachSurface('test-surface')
+    // The owner must be a store-registered session: the baseline walks the
+    // session list, and the wire frame addresses that session.
+    const session = ctx.sessions.create()
+    const agent = stubAgent(ctx, session.id)
+    ctx.agents.register(agent)
+    // A task starts before any mux consumer connects.
+    const owned = producer(agent)
+    const id = ctx.tasks.start(owned.spec)
+    const proxy = createApiProxy(ctx, { provider: 'p', model: 'm', cwd: '/tmp', workspaceRoot: '/tmp' })
+    await new Promise(resolve => setTimeout(resolve, 0))
+    const abort = new AbortController()
+    const stream = proxy.events.mux({ rpcId: RpcId('t-task-base'), payload: {} }, abort.signal)
+    const collected = collectTaskFrames(stream, 1, abort)
+    const frames = await collected
+    expect(frames).toEqual([
+      {
+        type: 'task/snapshot',
+        sessionId: session.id,
+        tasks: [expect.objectContaining({ id, status: 'running', label: 'sleep 60' })],
+      },
+    ])
+  })
+})
